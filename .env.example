# Supabase — get from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Google Analytics 4 (optional — leave blank to disable)
VITE_GA_MEASUREMENT_ID=

# ==============================================================================
# BACKEND / EDGE FUNCTION SECRETS (DO NOT PUT IN CLIENT .env OR EXPOSE WITH VITE_)
# Set these via Supabase CLI (`supabase secrets set KEY=VALUE`) or Supabase Dashboard:
# Project Settings > Edge Functions > Secrets
# ==============================================================================
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# GEMINI_API_KEY=...
# CRON_SECRET=... (generate with `openssl rand -hex 32` for scheduled-publish)
# SUPABASE_SERVICE_ROLE_KEY=... (pre-configured automatically in Supabase Edge Functions)
# SUPABASE_URL=https://your-project-ref.supabase.co (pre-configured automatically)
